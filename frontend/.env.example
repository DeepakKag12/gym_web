# FitNation Frontend Configuration Example

# Backend API Base URL
# In local development: http://localhost:5000/api
# In production: https://your-backend-api.onrender.com/api (or custom domain)
REACT_APP_API_URL=http://localhost:5000/api

# Optional: Enable demo mock data fallback when backend is unreachable (true/false)
REACT_APP_DEMO_DATA=false
