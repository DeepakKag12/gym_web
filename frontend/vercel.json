{
  "version": 2,
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "REACT_APP_API_URL": "https://g-ym-backend.vercel.app/api",
      "GENERATE_SOURCEMAP": "false"
    }
  }
}
